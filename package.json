{
  "name": "archify",
  "version": "1.0.0",
  "description": "Quick project scaffolding CLI for Node.js - set up MVC, Clean Architecture, or Hexagonal projects in seconds",
  "main": "dist/index.js",
  "bin": {
    "archify": "./bin/archify.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "scaffold",
    "boilerplate",
    "mvc",
    "clean-architecture",
    "hexagonal",
    "express",
    "fastify",
    "typescript",
    "project-generator"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin"
  ]
}
